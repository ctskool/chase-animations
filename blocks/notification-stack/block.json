{
  "name": "notification-stack",
  "title": "Notification stack",
  "summary": "Orders accelerate onto a frosted lock screen. Whole-text totals count with each landing, then the final result slams into a lasting accent finish.",
  "fonts": ["500 40px Inter", "600 40px Inter"],
  "motionBlur": true,
  "timing": {
    "keyAt": 3.5,
    "hold": 1.5,
    "exit": 0.32,
    "minKeyAt": 2.0
  },
  "keyMoment": "the final order settles, the total reads $2,560.00 in the accent colour, the summary slams to 1.08 scale, and the more pill pops below the stack",
  "overlayHeight": 960,
  "variables": [
    { "id": "appName", "type": "string", "label": "App or shop name", "default": "Wrenlo" },
    { "id": "date", "type": "string", "label": "Lock screen date", "default": "Thursday, October 22" },
    { "id": "clock", "type": "string", "label": "Lock screen time", "default": "9:41" },
    { "id": "summaryLabel", "type": "string", "label": "Summary label", "default": "Today" },
    { "id": "startingCount", "type": "number", "label": "Starting order count, including the first card", "default": 18, "min": 1, "step": 1 },
    { "id": "countLabel", "type": "string", "label": "Word after the order count", "default": "orders" },
    { "id": "startingTotal", "type": "number", "label": "Starting total, including the first card", "default": 1248, "min": 0, "step": 0.01 },
    { "id": "currency", "type": "string", "label": "Three-letter currency code", "default": "USD" },
    { "id": "timestamp", "type": "string", "label": "Card timestamp", "default": "now" },
    { "id": "cardFormat", "type": "string", "label": "Card body; keep [AMOUNT] and [N]", "default": "New order: [AMOUNT] · [N] items" },
