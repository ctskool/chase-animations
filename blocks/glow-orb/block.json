{
  "name": "glow-orb",
  "title": "Glow Orb",
  "summary": "A large shaded pink-white orb breathes above one line of type. The pink closing phrase arrives as its rim detaches and the edge circles recoil. A shorter hold carries the released ring into a gently tipped orbit.",
  "fonts": [
    "500 40px Outfit"
  ],
  "fontFiles": [
    "outfit-500.woff2"
  ],
  "timing": {
    "keyAt": 2.5,
    "hold": 1.15,
    "exit": 0.3,
    "minKeyAt": 1.3
  },
  "keyMoment": "the pink closing phrase finishes its arrival exactly at the breath crest, with the single rim detached and the supporting circles recoiling",
  "overlayHeight": 900,
  "variables": [
    {
      "id": "line",
      "type": "string",
      "label": "Short statement",
      "default": "Make room for stillness."
    },
    {
      "id": "outlineCircleCount",
      "type": "number",
      "label": "Outline circle count",
      "default": 7,
      "min": 0,
      "max": 12,
      "step": 1
    },
    {
      "id": "orbDiameter",
      "type": "number",
      "label": "Requested resting orb diameter",
      "default": 760,
      "min": 320,
      "max": 820,
      "step": 10
    },
    {
      "id": "typeSize",
      "type": "number",
      "label": "Requested full-output type size",
      "default": 144,
      "min": 40,
      "max": 160,
      "step": 1
    },
    {
      "id": "tracking",
      "type": "number",
      "label": "Letter spacing in em",
      "default": -0.03,
      "min": -0.05,
      "max": 0.02,
      "step": 0.005
    },
    {
      "id": "initialOrbScale",
      "type": "number",
      "label": "Opening orb size",
      "default": 0.88,
      "min": 0.5,
      "max": 0.94,
      "step": 0.01
    },
    {
      "id": "wordPulse",
      "type": "number",
      "label": "Pulse on earlier word arrivals (%)",
      "default": 1.6,
      "min": 0,
      "max": 6,
      "step": 0.1
    },
    {
      "id": "breathOvershoot",
      "type": "number",
      "label": "Key breath overshoot (%)",
      "default": 10,
      "min": 5,
      "max": 22,
      "step": 1
    },
    {
      "id": "breathAmount",
      "type": "number",
