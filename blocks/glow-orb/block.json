      "default": 2.5,
      "min": 1,
      "max": 3,
      "step": 0.1
    },
    {
      "id": "breathPeriod",
      "type": "number",
      "label": "Slow breath period in seconds",
      "default": 3,
      "min": 2,
      "max": 5,
      "step": 0.1
    },
    {
      "id": "wordStaggerFrames",
