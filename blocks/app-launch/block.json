{
  "name": "app-launch",
  "title": "App launch",
  "summary": "A broad studio phone receives a transaction. Its camera pill and percentage chip become readable cards, then clear for a much larger transfer payoff with an exact amount and solid accent-colour finish.",
  "fonts": [
    "500 40px 'Plus Jakarta Sans'",
    "700 40px 'Plus Jakarta Sans'",
    "800 40px 'Plus Jakarta Sans'"
  ],
  "fontFiles": [
    "plus-jakarta-sans-500.woff2",
    "plus-jakarta-sans-700.woff2",
    "plus-jakarta-sans-800.woff2"
  ],
  "motionBlur": true,
  "overlayHeight": 960,
  "timing": {
    "keyAt": 4,
    "hold": 1,
    "exit": 0.3,
    "minKeyAt": 2.4
  },
  "keyMoment": "the enlarged transfer reaches its exact amount, switches from processing to completion wording, and punches into a solid accent-colour surface with a white success check",
  "variables": [
    { "id": "appName", "type": "string", "label": "App name", "default": "Nuvori" },
    { "id": "appType", "type": "string", "label": "App description for accessibility", "default": "Personal finance" },
    { "id": "clockLabel", "type": "string", "label": "Phone clock", "default": "9:41" },
    { "id": "avatarLabel", "type": "string", "label": "Avatar initials", "default": "ML" },
    { "id": "greeting", "type": "string", "label": "Greeting", "default": "Good morning, Mara" },
    { "id": "balanceLabel", "type": "string", "label": "Main number label", "default": "Total balance" },
    { "id": "mainNumber", "type": "string", "label": "Main number", "default": "$24,680.00" },
    { "id": "deltaLabel", "type": "string", "label": "Balance change", "default": "+8.4% this month" },
    { "id": "recentLabel", "type": "string", "label": "Activity heading", "default": "Recent activity" },
    { "id": "viewAllLabel", "type": "string", "label": "Activity link", "default": "View all" },

    { "id": "chartMonday", "type": "string", "label": "Monday balance", "default": "$22,767.00" },
    { "id": "chartTuesday", "type": "string", "label": "Tuesday balance", "default": "$23,180.00" },
    { "id": "chartWednesday", "type": "string", "label": "Wednesday balance", "default": "$22,940.00" },
    { "id": "chartThursday", "type": "string", "label": "Thursday balance", "default": "$23,700.00" },
    { "id": "chartFriday", "type": "string", "label": "Friday balance", "default": "$23,420.00" },
    { "id": "chartSaturday", "type": "string", "label": "Saturday balance", "default": "$24,180.00" },
    { "id": "chartSunday", "type": "string", "label": "Sunday balance", "default": "$24,680.00" },
    { "id": "chartLabelMonday", "type": "string", "label": "Left chart label", "default": "Mon" },
    { "id": "chartLabelWednesday", "type": "string", "label": "Middle chart label", "default": "Wed" },
    { "id": "chartLabelSunday", "type": "string", "label": "Right chart label", "default": "Sun" },
    {
      "id": "chartFocus",
      "type": "enum",
      "label": "Day shown in the dark chart tag",
      "default": "thursday",
      "options": [
        { "value": "monday", "label": "Monday" },
        { "value": "tuesday", "label": "Tuesday" },
        { "value": "wednesday", "label": "Wednesday" },
        { "value": "thursday", "label": "Thursday" },
        { "value": "friday", "label": "Friday" },
        { "value": "saturday", "label": "Saturday" },
        { "value": "sunday", "label": "Sunday" }
      ]
    },

    { "id": "row1Title", "type": "string", "label": "Featured activity title", "default": "Design retainer" },
    { "id": "row1Date", "type": "string", "label": "Featured activity date", "default": "Today" },
    { "id": "row1Amount", "type": "string", "label": "Featured activity amount", "default": "+$3,200.00" },
    { "id": "row2Title", "type": "string", "label": "Reserved activity 2 title", "default": "Studio rent" },
    { "id": "row2Date", "type": "string", "label": "Reserved activity 2 date", "default": "Yesterday" },
    { "id": "row2Amount", "type": "string", "label": "Reserved activity 2 amount", "default": "−$850.00" },
    { "id": "row3Title", "type": "string", "label": "Reserved activity 3 title", "default": "Cloud storage" },
    { "id": "row3Date", "type": "string", "label": "Reserved activity 3 date", "default": "Yesterday" },
    { "id": "row3Amount", "type": "string", "label": "Reserved activity 3 amount", "default": "−$24.00" },

    { "id": "navHome", "type": "string", "label": "Navigation 1", "default": "Home" },
    { "id": "navActivity", "type": "string", "label": "Navigation 2", "default": "Activity" },
    { "id": "navGoals", "type": "string", "label": "Navigation 3", "default": "Goals" },

    { "id": "card1Title", "type": "string", "label": "Pill card title", "default": "Savings goal" },
    { "id": "card1Value", "type": "string", "label": "Pill card amount", "default": "$10,000.00" },
    { "id": "card1Caption", "type": "string", "label": "Pill card caption", "default": "Rainy-day fund complete" },
    { "id": "card2Title", "type": "string", "label": "Chip card title", "default": "Income this month" },
    { "id": "card2Value", "type": "string", "label": "Chip card amount", "default": "$6,420.00" },
    { "id": "card2Change", "type": "string", "label": "Chip card change", "default": "+12.8% vs. last month" },
    { "id": "card3PendingTitle", "type": "string", "label": "Transfer processing title", "default": "Transfer in progress" },
    { "id": "card3PendingCaption", "type": "string", "label": "Transfer processing caption", "default": "Moving to Travel fund" },
    { "id": "card3Title", "type": "string", "label": "Completed transfer title", "default": "Transfer complete" },
    { "id": "card3Value", "type": "string", "label": "Completed transfer amount", "default": "$450.00" },
    { "id": "card3Caption", "type": "string", "label": "Completed transfer caption", "default": "Moved to Travel fund" },

    { "id": "miniBar1", "type": "number", "label": "Decorative mini bar 1 height (%)", "default": 24, "min": 5, "max": 100, "step": 1 },
    { "id": "miniBar2", "type": "number", "label": "Decorative mini bar 2 height (%)", "default": 42, "min": 5, "max": 100, "step": 1 },
    { "id": "miniBar3", "type": "number", "label": "Decorative mini bar 3 height (%)", "default": 34, "min": 5, "max": 100, "step": 1 },
    { "id": "miniBar4", "type": "number", "label": "Decorative mini bar 4 height (%)", "default": 64, "min": 5, "max": 100, "step": 1 },
    { "id": "miniBar5", "type": "number", "label": "Decorative accent bar height (%)", "default": 92, "min": 5, "max": 100, "step": 1 },

    { "id": "phoneTurn", "type": "number", "label": "Final phone turn (degrees)", "default": -8, "min": -16, "max": -4, "step": 1 },
    { "id": "phonePitch", "type": "number", "label": "Final phone tilt (degrees)", "default": 3, "min": 0, "max": 6, "step": 1 },
    { "id": "phoneRoll", "type": "number", "label": "Final phone roll (degrees)", "default": 0, "min": -1, "max": 1, "step": 0.5 },
    { "id": "grainOpacity", "type": "number", "label": "Fine backdrop grain", "default": 0.055, "min": 0, "max": 0.15, "step": 0.005 },

    { "id": "brandColor", "type": "color", "label": "Product accent", "default": "#5260E8" },
    { "id": "brandTint", "type": "color", "label": "Pale accent tint", "default": "#EEF0FF" },
    { "id": "backdropTop", "type": "color", "label": "Studio backdrop top", "default": "#DFE6EE" },
    { "id": "backdropBottom", "type": "color", "label": "Studio backdrop bottom", "default": "#CFD8E2" },
    { "id": "backdropGlow", "type": "color", "label": "Light behind the phone", "default": "#F4F7FA" },
    { "id": "floorColor", "type": "color", "label": "Studio floor", "default": "#C3CEDA" },
    { "id": "ink", "type": "color", "label": "Main text and phone frame", "default": "#0E1116" },
    { "id": "muted", "type": "color", "label": "Secondary text", "default": "#626B78" },
    { "id": "surface", "type": "color", "label": "Screen and floating cards", "default": "#FFFFFF" },
    { "id": "lineColor", "type": "color", "label": "Interface rules and quiet bars", "default": "#E2E7EE" },
    { "id": "metalColor", "type": "color", "label": "Metal edge", "default": "#B3BECC" },
    { "id": "metalDark", "type": "color", "label": "Metal edge shade", "default": "#687486" },
    {
      "id": "overlayPosition",
      "type": "enum",
      "label": "Overlay position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    }
  ]
}