{
  "name": "screen-zoom",
  "title": "Screen zoom",
  "summary": "A compact editing window, a short cursor-led zoom and a large Publish control that completes destinations before revealing Published.",
  "fonts": ["400 40px Inter", "500 40px Inter", "600 40px Inter", "700 40px Inter", "500 40px 'JetBrains Mono'"],
  "motionBlur": true,
  "overlayHeight": 860,
  "timing": { "keyAt": 1.45, "hold": 2.3, "exit": 0.32, "minKeyAt": 1.0 },
  "keyMoment": "the cursor clicks the button",
  "variables": [
    { "id": "appName", "type": "string", "label": "App name", "default": "Northstar" },
    { "id": "projectName", "type": "string", "label": "Screen title", "default": "Spring launch video" },
    { "id": "subtitle", "type": "string", "label": "Line under the title", "default": "Ready to go" },
    { "id": "buttonLabel", "type": "string", "label": "Button text", "default": "Publish" },
    { "id": "pendingLabel", "type": "string", "label": "Button text while destinations complete", "default": "Publishing" },
    { "id": "doneLabel", "type": "string", "label": "Button text when every destination completes", "default": "Published" },
    { "id": "stepNumber", "type": "string", "label": "Step number", "default": "3" },
    { "id": "stepLabel", "type": "string", "label": "Step text", "default": "Click Publish" },
    { "id": "side1", "type": "string", "label": "Sidebar item 1", "default": "Projects" },
    { "id": "side2", "type": "string", "label": "Sidebar item 2", "default": "Exports" },
    { "id": "side3", "type": "string", "label": "Sidebar item 3", "default": "Settings" },
    { "id": "target1", "type": "string", "label": "List item 1", "default": "Website" },
    { "id": "target2", "type": "string", "label": "List item 2", "default": "Newsletter" },
    { "id": "target3", "type": "string", "label": "List item 3", "default": "Community" },
    { "id": "stat1Label", "type": "string", "label": "Stat 1 label", "default": "Length" },
    { "id": "stat1Value", "type": "string", "label": "Stat 1 value", "default": "00:42" },
    { "id": "stat2Label", "type": "string", "label": "Stat 2 label", "default": "File size" },
    { "id": "stat2Value", "type": "string", "label": "Stat 2 value", "default": "128 MB" },
    { "id": "timelineTimecode", "type": "string", "label": "Timeline timecode", "default": "00:00:18:12" },

    { "id": "screenImage", "type": "image", "label": "Your own screenshot (use at twice the window width so the zoom stays sharp)", "default": "" },
    { "id": "screenHtml", "type": "html", "label": "Your own screen as HTML, with data-target on the button", "default": "" },
    { "id": "targetX", "type": "number", "label": "Screenshot target X (% across)", "default": 80, "min": 0, "max": 100, "step": 0.5 },
    { "id": "targetY", "type": "number", "label": "Screenshot target Y (% down)", "default": 12, "min": 0, "max": 100, "step": 0.5 },
    { "id": "zoom", "type": "number", "label": "Zoom strength (outputs adapt to preserve panel breathing room)", "default": 2.1, "min": 1.3, "max": 3.5, "step": 0.1 },

    { "id": "accent", "type": "color", "label": "Button colour", "default": "#2563EB" },
    { "id": "playhead", "type": "color", "label": "Playhead colour", "default": "#FF5A4E" },
    { "id": "windowColor", "type": "color", "label": "Window colour", "default": "#1B1C20" },
    { "id": "chromeColor", "type": "color", "label": "Title bar colour", "default": "#212227" },
    { "id": "panelColor", "type": "color", "label": "Panel colour", "default": "#26272C" },
    { "id": "lineColor", "type": "color", "label": "Interface hairlines", "default": "#33353B" },
    { "id": "textColor", "type": "color", "label": "Interface text", "default": "#ECEEF1" },
    { "id": "mutedColor", "type": "color", "label": "Interface labels", "default": "#9A9FA8" },
    { "id": "previewColor", "type": "color", "label": "Quiet preview colour", "default": "#2A2B31" },
    { "id": "backdropA", "type": "color", "label": "Backdrop top left", "default": "#E3EFE9" },
    { "id": "backdropB", "type": "color", "label": "Backdrop right", "default": "#B8D7D6" },
    { "id": "backdropC", "type": "color", "label": "Backdrop bottom", "default": "#9CC4BD" },
    { "id": "overlayPosition", "type": "enum", "label": "Overlay position", "default": "top", "options": [{ "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }] }
  ]
}