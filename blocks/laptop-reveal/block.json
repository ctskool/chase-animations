{
  "name": "laptop-reveal",
  "title": "Laptop reveal",
  "summary": "A rounded aluminium laptop opens in a reflected studio, wakes on your product, scrolls decisively, and clicks into a large stamped name reveal.",
  "fonts": [
    "700 160px 'Inter Tight'",
    "800 240px 'Inter Tight'",
    "500 90px Inter"
  ],
  "three": true,
  "motionBlur": true,
  "overlayHeight": 1000,
  "timing": {
    "keyAt": 4,
    "hold": 1,
    "exit": 0.34,
    "minKeyAt": 2.4
  },
  "keyMoment": "The button confirms as the oversized product name stamps into place; the short line and one solid blue underline finish on the same frame.",
