{
  "name": "isometric-flow",
  "title": "Isometric flow",
  "summary": "A miniature 3D diorama of a three-step process: buildings rise, a van runs the road, the last step checks off.",
  "fonts": ["800 40px 'Inter Tight'", "700 40px 'Inter Tight'", "500 40px Inter"],
  "three": true,
  "overlayCard": false,
  "overlayHeight": 1000,
  "timing": { "keyAt": 3.2, "hold": 1.5, "exit": 0.36, "minKeyAt": 1.8 },
  "keyMoment": "the van brakes at the last step and its number turns into a check",
  "variables": [
    { "id": "title", "type": "string", "label": "Title", "default": "How your order ships" },
    { "id": "step1Name", "type": "string", "label": "Step 1 name", "default": "Pack" },
    { "id": "step1Time", "type": "string", "label": "Step 1 time", "default": "2 min" },
    { "id": "step2Name", "type": "string", "label": "Step 2 name", "default": "Sort" },
    { "id": "step2Time", "type": "string", "label": "Step 2 time", "default": "1 hr" },
    { "id": "step3Name", "type": "string", "label": "Step 3 name", "default": "Deliver" },
    { "id": "step3Time", "type": "string", "label": "Step 3 time", "default": "Next day" },

    { "id": "color1", "type": "color", "label": "Step 1 colour", "default": "#36C39A" },
    { "id": "color2", "type": "color", "label": "Step 2 colour", "default": "#3B6CF6" },
    { "id": "color3", "type": "color", "label": "Step 3 colour", "default": "#FF6A4D" },
    { "id": "chip", "type": "color", "label": "Number chip", "default": "#3B6CF6" },
    { "id": "check", "type": "color", "label": "Check", "default": "#1FB57F" },
    { "id": "slab", "type": "color", "label": "Slab", "default": "#F7F9FC" },
    { "id": "road", "type": "color", "label": "Road", "default": "#3A4458" },
    { "id": "ink", "type": "color", "label": "Text and details", "default": "#2B3445" },
    { "id": "bgTop", "type": "color", "label": "Background top", "default": "#EEF2F7" },
    { "id": "bgBottom", "type": "color", "label": "Background bottom", "default": "#E3E9F1" },
    { "id": "overlayPosition", "type": "enum", "label": "Overlay position", "default": "top", "options": [{ "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" }] }
  ]
}
