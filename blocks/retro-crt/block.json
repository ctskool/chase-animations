{
  "name": "retro-crt",
  "title": "Retro CRT",
  "summary": "A hot beam opens into two huge phosphor title strikes. Large terminal words arrive above a reserved status line. The complete status lands with a sharp title release, a beam flare, a red indicator and a warm glass flash. Moving glass carries the reading hold into a brief tube collapse.",
  "fonts": [
    "700 40px Syncopate",
    "400 40px 'Share Tech Mono'"
  ],
  "fontFiles": [
    "syncopate-700.woff2",
    "share-tech-mono-400.woff2"
  ],
  "timing": {
    "keyAt": 1.8333333333333333,
    "hold": 3.1666666666666665,
    "exit": 0.3,
    "minKeyAt": 1.1
  },
  "keyMoment": "the complete terminal status lands as the compressed title snaps into its tallest pose, a beam flares between the title lines, the red indicator strikes and warm light fills the glass",
  "overlayHeight": 760,
  "overlayCard": false,
  "variables": [
    {
      "id": "titleLine1",
      "type": "string",
      "label": "Title line 1",
      "default": "AFTER"
    },
    {
      "id": "titleLine2",
      "type": "string",
      "label": "Title line 2",
      "default": "HOURS"
    },
    {
      "id": "systemText",
      "type": "string",
      "label": "System message",
      "default": "CHANNEL 08 // LINK STABLE"
    },
    {
      "id": "titleWidth",
      "type": "number",
      "label": "Title width (% of stage)",
      "default": 90,
      "min": 65,
      "max": 94,
      "step": 1
    },
    {
      "id": "fullTitleHeight",
      "type": "number",
      "label": "Portrait title height multiplier",
      "default": 3.35,
      "min": 1,
      "max": 3.5,
      "step": 0.05
    },
    {
      "id": "topTitleHeight",
      "type": "number",
      "label": "Top title height multiplier",
      "default": 1.95,
      "min": 1,
      "max": 2.4,
      "step": 0.05
    },
    {
      "id": "overlayTitleHeight",
      "type": "number",
      "label": "Overlay title height multiplier",
      "default": 1.75,
      "min": 1,
      "max": 2,
      "step": 0.01
    },
    {
      "id": "tracking",
      "type": "number",
      "label": "Title letter spacing (% of type size)",
      "default": 4,
      "min": 0,
      "max": 10,
      "step": 0.5
    },
    {
      "id": "lineGap",
      "type": "number",
