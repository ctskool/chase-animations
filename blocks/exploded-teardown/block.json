    { "id": "referenceFps", "type": "number", "label": "Reference frames per second", "default": 30 },
    { "id": "firstLiftFrame", "type": "number", "label": "First release starts at frame", "default": 10 },
    { "id": "liftIntervalFrames", "type": "number", "label": "Frames between releases", "default": 20 },
    { "id": "leaderDelayFrames", "type": "number", "label": "Callout delay after release", "default": 4 },
