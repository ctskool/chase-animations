    { "id": "layerGapMm", "type": "number", "label": "Minimum full output physical gap in mm", "default": 20 },
    { "id": "compactGapMm", "type": "number", "label": "Minimum compact output physical gap in mm", "default": 10 },
    { "id": "projectionClearanceMm", "type": "number", "label": "Visible space between layer silhouettes in mm", "default": 3 },
    { "id": "baseLiftMm", "type": "number", "label": "Base release lift in mm", "default": 3.2 },
    { "id": "fullElevation", "type": "number", "label": "Full output final camera elevation", "default": 14 },
    { "id": "compactElevation", "type": "number", "label": "Compact output final camera elevation", "default": 10 },
    { "id": "cameraPullFrames", "type": "number", "label": "Closing composition move in frames", "default": 30 },
    { "id": "cameraOrbit", "type": "number", "label": "Build camera orbit in degrees", "default": 10 },
    { "id": "holdOrbit", "type": "number", "label": "Product turn during the hold in degrees", "default": 8 },
    { "id": "impactScale", "type": "number", "label": "Product scale punch at the key moment", "default": 1.055 },
    { "id": "shutterAngle", "type": "number", "label": "Motion blur shutter angle", "default": 120 },
    { "id": "temporalSamples", "type": "number", "label": "Fast-motion temporal samples", "default": 8 },

    { "id": "titleBarFrame", "type": "number", "label": "Progress rule starts at frame", "default": 0 },
    { "id": "titleBarFrames", "type": "number", "label": "Delayed rule entrance in frames", "default": 8 },
    { "id": "titleLine1Frame", "type": "number", "label": "Product heading starts at frame", "default": 0 },
    { "id": "titleLine2Frame", "type": "number", "label": "Closing headline starts at frame", "default": 126 },
    { "id": "titleSpecFrame", "type": "number", "label": "Dimensions start at frame", "default": 128 },
    { "id": "textRiseFrames", "type": "number", "label": "Whole title line settle in frames", "default": 6 },
    { "id": "grainAmount", "type": "number", "label": "Background grain strength", "default": 0.045 },
    { "id": "grainSeed", "type": "number", "label": "Background grain seed", "default": 17 },
    {
      "id": "overlayPosition",
      "type": "enum",
      "label": "Overlay position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    }
  ]
}