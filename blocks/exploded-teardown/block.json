    { "id": "coneColor", "type": "color", "label": "Paper cone", "default": "#34373B" },
    { "id": "rubberColor", "type": "color", "label": "Surround and foot", "default": "#101214" },
    { "id": "boardColor", "type": "color", "label": "Circuit board", "default": "#28744E" },
    { "id": "copperColor", "type": "color", "label": "Copper traces", "default": "#B6793D" },
    { "id": "silverColor", "type": "color", "label": "Battery pouches", "default": "#BEC4CA" },
