{
  "name": "before-after",
  "title": "Before and after",
  "summary": "A pressed handle drives a fast browser wipe, revealing a familiar bakery with bold new typography and three readable product cards. A brief accent marks the complete redesign while the bread and steam keep moving.",
  "fonts": [
    "700 40px 'Inter Tight'",
    "800 40px 'Inter Tight'",
    "500 40px Manrope",
    "700 40px Manrope",
    "800 40px Manrope",
    "400 40px 'Before Serif'",
    "700 40px 'Before Serif'"
  ],
  "fontFiles": [
    "manrope-500.woff2",
    "manrope-700.woff2",
    "manrope-800.woff2",
    "libre-caslon-text-400.woff2",
    "libre-caslon-text-700.woff2"
  ],
  "motionBlur": true,
  "overlayHeight": 960,
  "timing": {
    "keyAt": 2.6,
    "hold": 1.6,
    "exit": 0.32,
    "minKeyAt": 2.0
  },
  "keyMoment": "the last product card lands exactly as an accent flashes around the complete redesign; a tomato header rule remains while the loaf and steam continue moving",
  "variables": [
    { "id": "businessType", "type": "string", "label": "Business description", "default": "Independent neighbourhood bakery" },
    { "id": "changeDescription", "type": "string", "label": "Description of the makeover", "default": "A dated blue bakery website becomes a warm cream page with bold typography, terracotta accents and illustrated bread." },
    { "id": "headline1", "type": "string", "label": "Headline line 1", "default": "Same bakery." },
    { "id": "headline2", "type": "string", "label": "Headline line 2", "default": "A fresher website." },
    { "id": "address", "type": "string", "label": "Browser address", "default": "alderandcrumb.example" },
    { "id": "beforeLabel", "type": "string", "label": "Before chip", "default": "BEFORE" },
    { "id": "afterLabel", "type": "string", "label": "After chip", "default": "AFTER" },

    { "id": "oldName", "type": "string", "label": "Old business name", "default": "Alder & Crumb" },
    { "id": "sidebarLine1", "type": "string", "label": "Old subtitle", "default": "Family recipes." },
    { "id": "oldHeading1", "type": "string", "label": "Old heading line 1", "default": "Welcome to" },
    { "id": "oldHeading2", "type": "string", "label": "Old heading line 2", "default": "our bakery!" },
    { "id": "oldButton", "type": "string", "label": "Old button", "default": "View our menu" },
    { "id": "oldItem1", "type": "string", "label": "Old menu item 1", "default": "Butter croissant" },
    { "id": "oldPrice1", "type": "string", "label": "Old price 1", "default": "$4.50" },
    { "id": "oldItem2", "type": "string", "label": "Old menu item 2", "default": "Cinnamon morning bun" },
    { "id": "oldPrice2", "type": "string", "label": "Old price 2", "default": "$5.00" },
    { "id": "oldItem3", "type": "string", "label": "Old menu item 3", "default": "Country sourdough" },
    { "id": "oldPrice3", "type": "string", "label": "Old price 3", "default": "$9.00" },

    { "id": "newName", "type": "string", "label": "New business name", "default": "Alder & Crumb." },
    { "id": "newNav1", "type": "string", "label": "New navigation", "default": "Our menu" },
    { "id": "rightHeading1", "type": "string", "label": "New heading line 1", "default": "Small batches." },
    { "id": "rightHeading2", "type": "string", "label": "New heading line 2", "default": "Big mornings." },
    { "id": "newButton", "type": "string", "label": "New button", "default": "Explore the menu ↗" },
    { "id": "card1Name", "type": "string", "label": "New menu item 1", "default": "Butter croissant" },
    { "id": "card1Price", "type": "string", "label": "New price 1", "default": "$4.50" },
    { "id": "card2Name", "type": "string", "label": "New menu item 2", "default": "Cinnamon morning bun" },
    { "id": "card2Price", "type": "string", "label": "New price 2", "default": "$5.00" },
    { "id": "card3Name", "type": "string", "label": "New menu item 3", "default": "Country sourdough" },
    { "id": "card3Price", "type": "string", "label": "New price 3", "default": "$9.00" },

    { "id": "background", "type": "color", "label": "Backdrop", "default": "#e9edf0" },
    { "id": "backgroundTop", "type": "color", "label": "Backdrop top", "default": "#EEF1F6" },
    { "id": "backgroundBottom", "type": "color", "label": "Backdrop bottom", "default": "#E6EAF1" },
    { "id": "modernPage", "type": "color", "label": "Modern page", "default": "#fbf8f1" },
    { "id": "ink", "type": "color", "label": "Ink and headline", "default": "#272b27" },
    { "id": "accent", "type": "color", "label": "Terracotta accent", "default": "#ad472e" },
    { "id": "oldPage", "type": "color", "label": "Old page", "default": "#B3C5E0" },
    { "id": "oldBannerTop", "type": "color", "label": "Old banner top", "default": "#5C93DC" },
    { "id": "oldBannerBottom", "type": "color", "label": "Old banner bottom", "default": "#17458F" },
    { "id": "oldLink", "type": "color", "label": "Old blue links", "default": "#17458F" },
    { "id": "chrome", "type": "color", "label": "Browser bar", "default": "#DDE1E6" },
    { "id": "paper", "type": "color", "label": "Light text, cards and divider", "default": "#FFFFFF" },
    { "id": "buttonGrey", "type": "color", "label": "Old buttons and illustration panel", "default": "#D5D5D5" },
    { "id": "bread", "type": "color", "label": "Bread crust", "default": "#D6A260" },
    { "id": "breadDark", "type": "color", "label": "Bread scoring", "default": "#92572E" },

    { "id": "startSplit", "type": "number", "label": "Opening divider position (%)", "default": 97.5, "min": 85, "max": 99, "step": 0.5 },
    { "id": "beforeHold", "type": "number", "label": "Opening read pause at default timing (seconds)", "default": 0.78, "min": 0.45, "max": 1.1, "step": 0.05 },
    { "id": "handlePress", "type": "number", "label": "Handle press strength (%)", "default": 14, "min": 6, "max": 22, "step": 1 },
    { "id": "overshoot", "type": "number", "label": "Offscreen divider overshoot (%)", "default": 3.5, "min": 0, "max": 6, "step": 0.5 },
    { "id": "cardLift", "type": "number", "label": "Product card spring travel (pixels)", "default": 12, "min": 0, "max": 30, "step": 1 },
    { "id": "productNameSize", "type": "number", "label": "Full product name size (pixels)", "default": 46, "min": 40, "max": 60, "step": 1 },
    { "id": "compactProductNameSize", "type": "number", "label": "Compact product name size (pixels)", "default": 38, "min": 32, "max": 48, "step": 1 },
    { "id": "payoffPulse", "type": "number", "label": "Finished illustration pulse (%)", "default": 2.5, "min": 1, "max": 4, "step": 0.5 },
    { "id": "push", "type": "number", "label": "Bread illustration push in (%)", "default": 3, "min": 0, "max": 4, "step": 0.5 },
    { "id": "steamTravel", "type": "number", "label": "Steam rise over the shot (pixels)", "default": 52, "min": 16, "max": 72, "step": 2 },
    {
      "id": "overlayPosition",
      "type": "enum",
      "label": "Overlay position",
      "default": "top",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "bottom", "label": "Bottom" }
      ]
    }
  ]
}