{
  "name": "frosted-glass",
  "title": "Frosted glass",
  "summary": "A huge glass search builds in complete words, docks above three results and gives the chosen result a larger coral payoff with a snapping checkmark.",
  "fonts": [
    "500 132px 'Plus Jakarta Sans'",
    "600 104px 'Plus Jakarta Sans'",
    "600 132px 'Plus Jakarta Sans'"
  ],
  "fontFiles": [
    "plus-jakarta-sans-500.woff2",
    "plus-jakarta-sans-600.woff2"
  ],
  "three": true,
  "overlayHeight": 920,
  "timing": {
    "keyAt": 3.1,
    "hold": 1.6,
    "exit": 0.3,
    "minKeyAt": 1.7
  },
  "keyMoment": "the stretching highlight seats on the enlarged chosen row, turns bright coral and punches outward as the title jumps to its larger layout, the lettering reverses to dark and the return arrow becomes a checkmark",
  "variables": [
    {
      "id": "query",
      "type": "string",
      "label": "Search query",
      "default": "quiet stays in Bellhaven"
    },
    {
      "id": "row1Title",
      "type": "string",
      "label": "First result",
      "default": "Morrow Quay House"
    },
    {
      "id": "row1Label",
      "type": "string",
      "label": "Optional first result label",
      "default": ""
    },
    {
      "id": "row2Title",
      "type": "string",
      "label": "Second result",
      "default": "Fernlight Guest Rooms"
    },
    {
      "id": "row2Label",
      "type": "string",
      "label": "Optional second result label",
      "default": ""
    },
    {
      "id": "row3Title",
      "type": "string",
      "label": "Third result",
      "default": "Stillwater Courtyard"
    },
    {
      "id": "row3Label",
      "type": "string",
      "label": "Optional third result label",
      "default": ""
    },
    {
      "id": "selectedRow",
      "type": "number",
      "label": "Selected result",
      "default": 2,
      "min": 1,
      "max": 3,
      "step": 1
    },
    {
      "id": "textScale",
      "type": "number",
