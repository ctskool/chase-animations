{
  "name": "ranking-bars",
  "title": "Ranking bars",
  "summary": "Six categories race through changing years. Follow one orange hero through live overtakes, then land on its oversized final result.",
  "fonts": [
    "700 40px 'Inter Tight'",
    "800 40px 'Inter Tight'"
  ],
  "timing": {
    "keyAt": 4,
    "hold": 1,
    "exit": 0.32,
    "minKeyAt": 2.4
  },
  "keyMoment": "The final year and all six values become exact as the running caption cuts to Redhaven's oversized 130 TWh result. Its bar and first-place chip punch immediately afterwards.",
  "overlayHeight": 960,
  "variables": [
    {
      "id": "title",
      "type": "string",
      "label": "Title",
      "default": "The clean power race"
    },
    {
      "id": "subtitle",
      "type": "string",
      "label": "Subtitle",
      "default": "Annual clean generation in six fictional regions · TWh"
    },
    {
      "id": "category1",
      "type": "string",
      "label": "Category 1",
      "default": "Redhaven"
    },
    {
      "id": "category2",
      "type": "string",
      "label": "Category 2",
      "default": "Mossvale"
    },
    {
      "id": "category3",
      "type": "string",
      "label": "Category 3",
      "default": "Stoneford"
    },
    {
      "id": "category4",
      "type": "string",
      "label": "Category 4",
      "default": "Bluefen"
    },
    {
      "id": "category5",
      "type": "string",
      "label": "Category 5",
      "default": "Ashwick"
    },
    {
      "id": "category6",
      "type": "string",
      "label": "Category 6",
      "default": "Westmere"
    },
    {
