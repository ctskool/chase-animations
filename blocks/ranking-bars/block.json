      "label": "Axis and final-result units",
      "default": "TWh"
    },
    {
      "id": "yearlyValues",
      "type": "string",
      "label": "CSV: year followed by the six category values, in category order",
      "default": "Year,Redhaven,Mossvale,Stoneford,Bluefen,Ashwick,Westmere\n2020,34,78,66,53,42,28\n2021,43,82,71,61,49,35\n2022,58,88,77,69,57,42\n2023,73,93,82,78,63,50\n2024,91,99,88,87,70,59\n2025,111,106,94,96,76,68\n2026,130,113,101,105,83,78"
