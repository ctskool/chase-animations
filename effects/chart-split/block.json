{
  "name": "chart-split",
  "title": "Chart Split",
  "summary": "Split layout: a clean bar chart fills the top, you sit in the card below with your head breaking its edge. The small bars grow straight away; the highlighted ones slam in at their real value on your word.",
  "fonts": ["800 40px 'Inter Tight'", "500 34px 'Inter'"],
  "layers": ["back"],
  "layout": "split",
  "timing": { "keyAt": 0.65 },
  "keyMoment": "the highlighted bars shoot to full length and their numbers slam in on the word",
  "variables": [
    { "id": "title", "type": "string", "label": "Chart title", "default": "GitHub stars" },
    { "id": "note", "type": "string", "label": "Small note top right (source or date)", "default": "Nov 2, 2026" },
    { "id": "highlight", "type": "string", "label": "Bars to highlight with the accent, landing on the key word (names or numbers, comma separated)", "default": "Taste Skill, Impeccable" },
    { "id": "s1Name", "type": "string", "label": "Item 1 name", "default": "Taste Skill" },
    { "id": "s1By", "type": "string", "label": "Item 1 author", "default": "Leonxlnx" },
    { "id": "s1Value", "type": "number", "label": "Item 1 value", "default": 108731 },
    { "id": "s2Name", "type": "string", "label": "Item 2 name", "default": "Impeccable" },
    { "id": "s2By", "type": "string", "label": "Item 2 author", "default": "Paul Bakaus" },
    { "id": "s2Value", "type": "number", "label": "Item 2 value", "default": 100475 },
    { "id": "s3Name", "type": "string", "label": "Item 3 name", "default": "Playwright CLI" },
    { "id": "s3By", "type": "string", "label": "Item 3 author", "default": "Microsoft" },
    { "id": "s3Value", "type": "number", "label": "Item 3 value", "default": 14887 },
    { "id": "s4Name", "type": "string", "label": "Item 4 name", "default": "Unslop" },
    { "id": "s4By", "type": "string", "label": "Item 4 author", "default": "Damir Sokolovsky" },
    { "id": "s4Value", "type": "number", "label": "Item 4 value", "default": 6270 },
    { "id": "s5Name", "type": "string", "label": "Item 5 name", "default": "Design Extract" },
    { "id": "s5By", "type": "string", "label": "Item 5 author", "default": "Manavarya09" },
    { "id": "s5Value", "type": "number", "label": "Item 5 value", "default": 4470 },
    { "id": "page", "type": "color", "label": "Page colour", "default": "#F2EFE9" },
    { "id": "accent", "type": "color", "label": "Accent for the highlighted bars", "default": "#E4553B" }
  ]
}
